{
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/sdk/:path*", "destination": "/api" },
    { "source": "/public/:path*", "destination": "/api" },
    { "source": "/demo/:path*", "destination": "/api" }
  ],
  "functions": { "api/index.js": { "maxDuration": 60 } }
}
