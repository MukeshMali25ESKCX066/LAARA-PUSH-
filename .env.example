# ---- Database ----
# Production / Vercel: Turso database (free). Leave both empty for local dev (uses ./data/pushdesk.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- App ----
PORT=3000
# Public https URL of this panel, no trailing slash (e.g. https://your-project.vercel.app)
BASE_URL=http://localhost:3000
VAPID_SUBJECT=mailto:you@example.com
ALLOW_SIGNUP=true

# ---- Image storage (required on Vercel; connect a Blob store in project settings) ----
BLOB_READ_WRITE_TOKEN=

# Optional. Auto-generated and stored in the database if empty.
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
